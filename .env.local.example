# ── name.ai partner API (search + quotes + orders) ──────────────────────────
NAMEAI_API_BASE_URL=https://name-stage.vps4.auctionhacker.com
NAMEAI_API_KEY_ID=pk_live_xxxxxxxxxxxx
NAMEAI_API_SECRET=sk_live_xxxxxxxxxxxx

# ── Partner's OWN Stripe (the partner is Merchant of Record; collects payment) ──
# Use a Stripe TEST secret key (sk_test_...). Buyers pay here; on success the
# partner notifies name.ai which records the sale (partner-collected).
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Stripe webhook signing secret (whsec_...) for POST /api/pay/webhook — the reliable
# server-to-server notifier. Get it from the Stripe webhook destination you create:
#   Destination URL = https://<this-app-host>/api/pay/webhook
#   Event           = checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Public origin for Stripe success/cancel redirects.
# Local: http://localhost:3001  ·  Deployed: your Vercel URL
NEXT_PUBLIC_APP_URL=http://localhost:3001
